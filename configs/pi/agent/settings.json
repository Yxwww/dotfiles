  "packages": [
    "npm:pi-vimmode@0.9.0",
    "npm:@pi-stef/atlassian@0.4.3",
    "npm:pi-search-hub@2.8.0",
    "npm:pi-subagents",
    "npm:@piotr-oles/pi-reflag",
