# Function to determine the package manager and run the appropriate command
function run_command() {
  local cmd=$1
  if [ -f "package.json" ]; then
    if [ -f "yarn.lock" ]; then
      yarn $cmd
    elif [ -f "pnpm-lock.yaml" ]; then
      pnpm $cmd
    else
      npm run $cmd
    fi
  else
    echo "No package.json found"
  fi
}

function n_dev() {
  run_command "dev"
}
function n_install() {
  run_command "install"
}
function n_start() {
  run_command "start"
}

# Shared aliases (git/gh/misc) — single source of truth, also loaded by pi's bash.
[ -f ~/.aliases ] && source ~/.aliases

# zsh-only command overrides (deliberately NOT shared with bash)
# alias l='ls -lFhG'
alias l='eza'
alias ls='eza --classify --all --long --no-user --header --icons'
alias cat='bat'

